% UQ Gemini theme
% See: https://github.com/alfurka/gemini-uq
% Forked from
% https://rev.cs.uchicago.edu/k4rtik/gemini-uccs
% which is forked from
% https://github.com/anishathalye/gemini

% ====================
% Definitions
% ====================

\definecolor{maroon}{RGB}{128, 0, 0}
\definecolor{darkgray}{RGB}{118, 118, 118}
\definecolor{lightgray}{RGB}{234, 234, 234}
\definecolor{UQmain}{HTML}{546d78}
%\definecolor{UQmain}{RGB}{251, 69, 112}

% Secondary
\definecolor{yellow}{RGB}{248, 164, 41}
\definecolor{orange}{RGB}{193, 102, 34}
\definecolor{red}{RGB}{143, 57, 49}
\definecolor{lightgreen}{RGB}{145, 171, 90}
\definecolor{darkgreen}{RGB}{88, 89, 63}
\definecolor{blue}{RGB}{21, 95, 131}
\definecolor{violet}{RGB}{53, 14, 32}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=violet}

% Headline
\setbeamercolor{headline}{fg=black,bg=white}
\setbeamercolor{headline title}{fg=UQmain}
\setbeamercolor{headline author}{fg=black}
\setbeamercolor{headline institute}{fg=darkgray}
\setbeamercolor{headline rule}{bg=white}

% Block
\setbeamercolor{block title}{fg=UQmain,bg=white}
\setbeamercolor{block separator}{bg=black}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=UQmain,bg=lightgray}
\setbeamercolor{block alerted separator}{bg=black}
\setbeamercolor{block alerted body}{fg=black,bg=lightgray}

% Heading
\setbeamercolor{heading}{fg=black}

% Sidebar
\setbeamercolor{sidebar canvas left}{bg=UQmain}
\setbeamercolor{sidebar left}{fg=white}

% Itemize
\setbeamercolor{item}{fg=darkgray}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
\setbeamertemplate{bibliography entry article}{}
\setbeamertemplate{bibliography entry title}{}
\setbeamertemplate{bibliography entry location}{}
\setbeamertemplate{bibliography entry note}{}